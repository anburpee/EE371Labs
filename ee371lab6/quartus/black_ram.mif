-- Quartus Prime generated Memory Initialization File (.mif)

WIDTH=7;
DEPTH=16;

ADDRESS_RADIX=UNS;
DATA_RADIX=BIN;

CONTENT BEGIN
	0   :   0001000;
	1   :   0011000;
	2   :   0101000;
	3   :   0111000;
	4   :   0000001;
	5   :   0010001;
	6   :   0100001;
	7   :   0110001;
	8   :   0001010;
	9   :   0011010;
	10  :   0101010;
	11  :   0111010;
	[12..15]  :   0000000;
END;
